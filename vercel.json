{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "redirects": [{ "source": "/resume.pdf", "destination": "/cv.pdf", "permanent": false }],
  "headers": [
    {
      "source": "/cv.pdf",
      "headers": [{ "key": "Content-Disposition", "value": "inline; filename=\"Abdulrhman_Hany_CV.pdf\"" }]
    }
  ]
}
